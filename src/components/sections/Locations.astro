---
import { Clock, DeviceMobile, MapPin, MapTrifold } from '@phosphor-icons/react';
import { imgProps, type PhotoKey } from '../../data/photos';

const branches: {
  name: string; tag: string; address: string; city: string; hours: string; phone: string;
  mapSrc: string; photo: PhotoKey; flavor: string;
}[] = [
  {
    name: 'Petalé Senayan',
    tag: 'Flagship',
    address: 'Plaza Senayan, Lt. 3',
    city: 'Jakarta Selatan',
    hours: '10:00 – 22:00',
    phone: '+62 812-0001-0001',
    photo: 'shelves',
    flavor: 'strawberry',
    mapSrc: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.2!2d106.7999!3d-6.2271!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zPlaza+Senayan!5e0!3m2!1sen!2sid!4v1700000000000',
  },
  {
    name: 'Petalé Kuningan',
    tag: '',
    address: 'Kota Kasablanka, Lt. 2',
    city: 'Jakarta Selatan',
    hours: '10:00 – 22:00',
    phone: '+62 812-0001-0002',
    photo: 'salonTechs',
    flavor: 'taro',
    mapSrc: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3966.2!2d106.8369!3d-6.2252!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zKota+Kasablanka!5e0!3m2!1sen!2sid!4v1700000000000',
  },
  {
    name: 'Petalé Surabaya',
    tag: '',
    address: 'Pakuwon Mall, Lt. 1',
    city: 'Surabaya',
    hours: '10:00 – 22:00',
    phone: '+62 812-0001-0003',
    photo: 'swatchFan',
    flavor: 'mango',
    mapSrc: 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3957.2!2d112.6546!3d-7.2949!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zPakuwon+Mall!5e0!3m2!1sen!2sid!4v1700000000000',
  },
];
---

<section id="locations" class="section-rhythm locations-section">
  <div class="container-petale">

    <div class="section-head">
      <h2 class="display-lg">Mampir ke Petalé</h2>
      <p class="lede">Tiga outlet di Jakarta dan Surabaya, semuanya buka setiap hari dan siap menyambutmu. <em>Alamat dan foto adalah contoh.</em></p>
    </div>

    <div class="branches">
      {branches.map((b, i) => (
        <article class:list={['branch', i === 0 && 'flagship']} data-flavor={b.flavor}>
          <div class="branch-photo photo-frame">
            <img {...imgProps(b.photo, i === 0 ? 640 : 360, i === 0 ? 480 : 300)} />
            {b.tag && <span class="sticker branch-tag" style="--sticker: var(--color-mango); --r: -6deg;">{b.tag}</span>}
          </div>
          <div class="branch-body">
            <h3 class="branch-name">{b.name}</h3>
            <p class="branch-address"><MapPin size={16} weight="fill" /> {b.address}, {b.city}</p>
            <p class="branch-meta"><Clock size={16} weight="fill" /> {b.hours} setiap hari</p>
            <p class="branch-meta"><DeviceMobile size={16} weight="fill" /> <a href={`tel:${b.phone.replace(/\s|-/g, '')}`}>{b.phone}</a></p>

            <details class="branch-map">
              <summary><MapTrifold size={16} weight="bold" /> Lihat peta</summary>
              <iframe
                src={b.mapSrc}
                title={`Peta ${b.name}`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
              ></iframe>
            </details>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
