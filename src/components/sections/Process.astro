---
import { Coffee, ChatsCircle, ShieldCheck, HandHeart, PaintBrush, Sun, Camera, Heart } from '@phosphor-icons/react';
import { imgProps } from '../../data/photos';

const steps = [
  { Icon: Coffee,      name: 'Welcome drink',      note: 'Kopi, teh, atau lemon water', time: 10 },
  { Icon: ChatsCircle, name: 'Konsultasi singkat', note: 'Diskusi desain dan cek kondisi kuku', time: 10 },
  { Icon: ShieldCheck, name: 'Sterilisasi',        note: 'Tools steril autoclave 121°C di depan matamu', time: 10 },
  { Icon: HandHeart,   name: 'Pampering session',  note: 'Cuticle care, shaping, base coat', time: 15 },
  { Icon: PaintBrush,  name: 'Nail art magic',     note: 'Nail artist mulai berkarya', time: 30 },
  { Icon: Sun,         name: 'Top coat & UV cure', note: 'Finishing supaya awet berminggu-minggu', time: 10 },
  { Icon: Camera,      name: 'Photo moment',       note: 'Spot foto cantik untuk OOTD kukumu', time: 5 },
];
const total = steps.reduce((s, x) => s + x.time, 0);
---

<section id="process" class="section-rhythm process-section pearls" data-flavor="taro" style="--surface: var(--color-taro-soft);">
  <div class="container-petale process-grid">

    <div class="process-copy">
      <div class="section-head">
        <h2 class="display-lg">Struk Pesananmu: 90 Menit yang Bikin Happy</h2>
        <p class="lede">Dari duduk sampai foto, ini semua yang kamu dapat di setiap kunjungan.</p>
      </div>

      <div class="receipt-wrap">
        <div class="receipt">
          <p class="receipt-title">PETALÉ NAIL STUDIO</p>
          <p class="receipt-sub">Struk contoh · Meja 7</p>
          <hr class="receipt-rule" />
          <ol class="receipt-lines">
            {steps.map(s => (
              <li>
                <span class="r-icon"><s.Icon size={18} weight="bold" /></span>
                <span class="r-main">
                  <span class="r-name">1x {s.name}</span>
                  <span class="r-note">{s.note}</span>
                </span>
                <span class="r-time">{s.time}m</span>
              </li>
            ))}
          </ol>
          <hr class="receipt-rule" />
          <p class="receipt-total"><span>TOTAL SESI</span><span>{total} menit</span></p>
          <p class="receipt-thanks"><Heart size={14} weight="fill" /> Terima kasih, sampai ketemu lagi! <Heart size={14} weight="fill" /></p>
          <div class="barcode" aria-hidden="true"></div>
        </div>
      </div>
    </div>

    <div class="process-visual" aria-hidden="false">
      <div class="proc-photo proc-a photo-frame arch"><img {...imgProps('lilacFace', 420, 540)} /></div>
      <div class="proc-photo proc-b photo-frame"><img {...imgProps('boba4', 260, 260)} /></div>
      <div class="proc-photo proc-c photo-frame"><img {...imgProps('uvLamp', 240, 240)} /></div>
      <span class="sticker proc-s1" style="--sticker: var(--color-mango); --r: -7deg;">Welcome drink gratis</span>
      <span class="sticker proc-s2" style="--sticker: var(--color-matcha); --r: 5deg;">Photo moment</span>
    </div>

  </div>
</section>
