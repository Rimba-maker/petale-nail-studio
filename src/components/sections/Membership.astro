---
import { Star, Gift, Check, FlowerLotus } from '@phosphor-icons/react';

const stamps = 10;
const stamped = 4;

const tiers = [
  {
    name: 'Monthly Beauty Pass',
    price: 'Rp 850k',
    per: '/ bulan',
    flavor: 'taro',
    perks: ['1x Gel Manicure', '1x Gel Pedicure', 'Diskon 10% nail art', 'Diskon 5% acrylic & BIAB'],
  },
  {
    name: 'Quarterly Indulgence',
    price: 'Rp 2,4jt',
    per: '/ 3 bulan',
    flavor: 'mango',
    badge: 'Hemat 15%',
    perks: ['3x Gel Manicure', '3x Gel Pedicure', '1x Spa Pedicure', 'Diskon 15% semua layanan', 'Free hand spa tiap bulan'],
  },
];
---

<section id="membership" class="section-rhythm member-section">
  <div class="container-petale">

    <div class="section-head">
      <h2 class="display-lg">Petalé Members</h2>
      <p class="lede">Makin sering mampir, makin banyak yang kamu dapat. Kumpulkan stempelnya, tukar dengan yang manis-manis.</p>
    </div>

    <div class="member-grid">

      <div class="stamp-card-wrap">
        <div class="stamp-card">
          <div class="stamp-card-head">
            <span class="stamp-brand"><FlowerLotus size={20} weight="fill" /> Petalé</span>
            <span class="stamp-title">Kartu Stempel</span>
          </div>
          <ol class="stamp-slots" aria-label={`Contoh kartu: ${stamped} dari ${stamps} stempel terkumpul`}>
            {Array.from({ length: stamps }).map((_, i) => (
              <li class:list={['slot', i < stamped && 'done', i === stamps - 1 && 'prize']} style={`--tilt: ${(i * 37) % 14 - 7}deg`}>
                {i === stamps - 1
                  ? <Gift size={26} weight="fill" />
                  : i < stamped
                    ? <Star size={26} weight="fill" />
                    : <span class="slot-n">{i + 1}</span>}
              </li>
            ))}
          </ol>
          <p class="stamp-foot">Stempel ke-10 = hadiah kejutan. <em>Contoh ilustrasi.</em></p>
        </div>
      </div>

      <div class="tiers">
        {tiers.map(t => (
          <article class="tier" data-flavor={t.flavor}>
            {t.badge && <span class="sticker tier-badge" style="--sticker: var(--color-rose); --r: 6deg;">{t.badge}</span>}
            <h3 class="tier-name">{t.name}</h3>
            <p class="tier-price"><strong>{t.price}</strong> <span>{t.per}</span></p>
            <ul class="tier-perks">
              {t.perks.map(p => <li><Check size={18} weight="bold" /> {p}</li>)}
            </ul>
            <a href="#booking" class="btn-primary">Gabung</a>
          </article>
        ))}

        <div class="gift-strip">
          <Gift size={30} weight="fill" />
          <div>
            <strong>Gift Card</strong>
            <span>Mulai Rp 200k, fleksibel untuk layanan apa saja.</span>
          </div>
          <a href="#booking" class="btn-secondary">Beli</a>
        </div>
      </div>

    </div>
  </div>
</section>
