---
import { FlowerLotus, Sparkle } from '@phosphor-icons/react';

const links = [
  { href: '#services', label: 'Menu' },
  { href: '#catalog', label: 'Desain' },
  { href: '#membership', label: 'Member' },
  { href: '#locations', label: 'Lokasi' },
];
---

<header id="navbar" class="navbar">
  <div class="navbar-pill">

    <a href="#top" class="navbar-logo" aria-label="Petalé Nail Studio, ke atas">
      <span class="logo-mark"><FlowerLotus size={22} weight="fill" /></span>
      <span class="logo-text">Petalé</span>
    </a>

    <nav class="navbar-nav" aria-label="Navigasi utama">
      {links.map(l => <a href={l.href} class="nav-link">{l.label}</a>)}
    </nav>

    <a href="#booking" class="btn-primary navbar-cta"><Sparkle size={15} weight="fill" /> Pesan</a>

    <button class="hamburger" id="hamburger-btn" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
    <nav class="mobile-nav" aria-label="Navigasi seluler">
      {links.map(l => <a href={l.href} class="mobile-nav-link">{l.label}</a>)}
      <a href="#booking" class="btn-primary"><Sparkle size={15} weight="fill" /> Pesan slot</a>
    </nav>
  </div>
</header>

<style>
  .navbar {
    position: fixed; top: 12px; left: 0; right: 0; z-index: 100;
    padding-inline: 12px; pointer-events: none;
  }
  .navbar-pill {
    pointer-events: auto;
    max-width: 1100px; margin-inline: auto;
    display: flex; align-items: center; gap: 16px;
    height: 64px; padding: 0 10px 0 20px;
    background: var(--color-milk);
    border: var(--outline); border-radius: var(--radius-pill);
    box-shadow: var(--shadow-float);
  }
  .navbar-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; flex: none; }
  .logo-mark {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%;
    background: var(--color-rose); border: 2.5px solid var(--color-cocoa); color: var(--color-cocoa);
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .navbar-logo:hover .logo-mark { transform: rotate(72deg) scale(1.1); }
  .logo-text { font-family: var(--font-display); font-size: 26px; color: var(--color-cocoa); line-height: 1; }

  .navbar-nav { display: flex; gap: 2px; flex: 1; justify-content: center; }
  .nav-link {
    font-weight: 800; font-size: 15px; color: var(--color-cocoa); text-decoration: none;
    padding: 9px 16px; border-radius: var(--radius-pill);
    transition: background-color 0.15s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .nav-link:hover { background: var(--color-mango-soft); transform: translateY(-2px) rotate(-1.5deg); }
  .navbar-cta { min-height: 44px; }

  .hamburger {
    display: none; flex-direction: column; justify-content: center; gap: 5px;
    width: 44px; height: 44px; margin-left: auto; padding: 0 11px;
    background: var(--color-mango-soft); border: 2px solid var(--color-cocoa); border-radius: 50%; cursor: pointer;
  }
  .hamburger span { display: block; height: 2.5px; background: var(--color-cocoa); border-radius: 2px; transition: transform 0.25s ease, opacity 0.2s ease; }
  .hamburger.open span:nth-child(1) { transform: translateY(7.5px) rotate(45deg); }
  .hamburger.open span:nth-child(2) { opacity: 0; }
  .hamburger.open span:nth-child(3) { transform: translateY(-7.5px) rotate(-45deg); }

  .mobile-drawer {
    pointer-events: auto; display: none;
    max-width: 1100px; margin: 10px auto 0;
    grid-template-rows: 0fr; visibility: hidden;
    background: var(--color-milk); border: var(--outline); border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    transition: grid-template-rows 0.3s ease, visibility 0.3s;
  }
  .mobile-drawer.open { grid-template-rows: 1fr; visibility: visible; }
  .mobile-nav { display: flex; flex-direction: column; gap: 4px; padding: 14px; min-height: 0; overflow: hidden; }
  .mobile-nav-link {
    font-weight: 800; font-size: 18px; color: var(--color-cocoa); text-decoration: none;
    padding: 12px 16px; border-radius: var(--radius-md);
  }
  .mobile-nav-link:hover { background: var(--color-mango-soft); }
  .mobile-nav .btn-primary { margin-top: 6px; }

  @media (max-width: 820px) {
    .navbar-nav { display: none; }
    .navbar-cta { margin-left: auto; min-height: 42px; padding: 0 18px; }
    .hamburger { display: flex; margin-left: 0; }
    .mobile-drawer { display: grid; }
    .navbar-pill { padding-right: 10px; }
  }
</style>

<script>
  const btn = document.getElementById('hamburger-btn');
  const drawer = document.getElementById('mobile-drawer');

  const setOpen = (open: boolean) => {
    btn?.classList.toggle('open', open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Tutup menu' : 'Buka menu');
    drawer?.classList.toggle('open', open);
    drawer?.setAttribute('aria-hidden', String(!open));
  };

  btn?.addEventListener('click', () => setOpen(!btn.classList.contains('open')));
  drawer?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', e => e.key === 'Escape' && setOpen(false));
</script>
