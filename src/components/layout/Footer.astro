---
import { InstagramLogo, TiktokLogo, PinterestLogo, Sparkle, FlowerLotus, MapPin } from '@phosphor-icons/react';

const navLinks = [
  { label: 'Menu',   href: '#services' },
  { label: 'Desain', href: '#catalog' },
  { label: 'Member', href: '#membership' },
  { label: 'Lokasi', href: '#locations' },
];

const socials = [
  { label: 'Instagram', href: 'https://instagram.com/petale.id', Icon: InstagramLogo },
  { label: 'TikTok',    href: 'https://tiktok.com/@petale.id',   Icon: TiktokLogo },
  { label: 'Pinterest', href: 'https://pinterest.com/petale_id', Icon: PinterestLogo },
];
---

<footer class="footer">
  <div class="container-petale">

    <div class="footer-grid">

      <div class="footer-brand">
        <a href="#top" class="footer-logo" aria-label="Petalé Nail Studio, ke atas">
          <span class="logo-mark"><FlowerLotus size={22} weight="fill" /></span>
          <span class="footer-logo-text">Petalé</span>
        </a>
        <p class="footer-tagline">Crafted, polished, loved.</p>
        <div class="socials">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="social-link" aria-label={s.label}>
              <s.Icon size={20} weight="fill" />
            </a>
          ))}
        </div>
      </div>

      <div class="footer-col">
        <h2 class="footer-col-title">Jelajah</h2>
        {navLinks.map(l => <a href={l.href} class="footer-link">{l.label}</a>)}
      </div>

      <div class="footer-col">
        <h2 class="footer-col-title">Jam buka</h2>
        <p class="footer-text">Senin – Minggu</p>
        <p class="footer-hours">10:00 – 22:00</p>
        <p class="footer-text footer-where"><MapPin size={16} weight="fill" /> Jakarta & Surabaya</p>
      </div>

      <div class="footer-col">
        <h2 class="footer-col-title">Bocoran desain</h2>
        <p class="footer-text">Inspirasi desain tiap bulan dan promo, langsung ke inbox-mu.</p>
        <form class="newsletter-form" id="nl-form">
          <label for="nl-email" class="sr-only">Email kamu</label>
          <input id="nl-email" type="email" placeholder="email kamu" required class="nl-input" autocomplete="email" />
          <button type="submit" class="nl-btn" aria-label="Kirim"><Sparkle size={18} weight="fill" /></button>
        </form>
        <p class="nl-thanks" id="nl-thanks" hidden>Makasih! Cek inbox ya.</p>
      </div>

    </div>

    <div class="footer-bottom">
      <p>© 2026 Petalé Nail Studio. Proyek demo, semua data dan harga adalah contoh.</p>
      <p>Foto oleh kontributor <a href="https://unsplash.com" target="_blank" rel="noopener noreferrer">Unsplash</a> dan <a href="https://www.pexels.com" target="_blank" rel="noopener noreferrer">Pexels</a>.</p>
    </div>

  </div>
</footer>

<script>
  const form = document.getElementById('nl-form') as HTMLFormElement | null;
  const thanks = document.getElementById('nl-thanks');
  form?.addEventListener('submit', e => {
    e.preventDefault();
    form.reset();
    if (thanks) thanks.hidden = false;
  });
</script>
